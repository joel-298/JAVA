import java.util.HashSet;
import java.util.LinkedHashSet;
import java.util.TreeSet;
import java.util.Set;
import java.util.Comparator;

public class Main {
    public static void main(String[] args) {

        // =========================================================
        // 1. HASHSET
        // =========================================================

        Set<Integer> hashSet = new HashSet<>();

        hashSet.add(10);
        hashSet.add(5);
        hashSet.add(20);
        hashSet.add(10); // Duplicate -> ignored

        System.out.println("HashSet: " + hashSet);
        System.out.println("Size: " + hashSet.size());

        // HashSet does NOT maintain insertion order
        // HashSet does NOT maintain sorted order


        // =========================================================
        // 2. LINKEDHASHSET
        // =========================================================

        Set<Integer> linkedHashSet = new LinkedHashSet<>();

        linkedHashSet.add(10);
        linkedHashSet.add(5);
        linkedHashSet.add(20);
        linkedHashSet.add(10); // Duplicate -> ignored

        System.out.println("LinkedHashSet: " + linkedHashSet);
        System.out.println("Size: " + linkedHashSet.size());

        // Maintains INSERTION ORDER
        // 10 -> 5 -> 20


        // =========================================================
        // 3. TREESET
        // =========================================================

        Set<Integer> treeSet = new TreeSet<>();

        treeSet.add(10);
        treeSet.add(5);
        treeSet.add(20);
        treeSet.add(10); // Duplicate -> ignored

        System.out.println("TreeSet: " + treeSet);

        // TreeSet automatically sorts in ASCENDING order
        // [5, 10, 20]


        // =========================================================
        // 4. TREESET DESCENDING ORDER
        // =========================================================

        Set<Integer> reverseTreeSet =
                new TreeSet<>(Comparator.reverseOrder());

        reverseTreeSet.add(10);
        reverseTreeSet.add(5);
        reverseTreeSet.add(20);

        System.out.println("TreeSet Descending: " + reverseTreeSet);

        // [20, 10, 5]


        // =========================================================
        // 5. BASIC SET OPERATIONS
        // =========================================================

        Set<Integer> a = new HashSet<>();

        a.add(1);
        a.add(2);
        a.add(3);

        Set<Integer> b = new HashSet<>();

        b.add(3);
        b.add(4);
        b.add(5);


        // UNION
        // A + B
        Set<Integer> union = new HashSet<>(a);
        union.addAll(b);

        System.out.println("Union: " + union);


        // INTERSECTION
        // Common elements
        Set<Integer> intersection = new HashSet<>(a);
        intersection.retainAll(b);

        System.out.println("Intersection: " + intersection);


        // DIFFERENCE
        // A - B
        Set<Integer> difference = new HashSet<>(a);
        difference.removeAll(b);

        System.out.println("A - B: " + difference);


        // B - A
        Set<Integer> difference2 = new HashSet<>(b);
        difference2.removeAll(a);

        System.out.println("B - A: " + difference2);


        // =========================================================
        // 6. CHECKING ELEMENTS
        // =========================================================

        System.out.println(a.contains(2)); // true
        System.out.println(a.contains(10)); // false


        // =========================================================
        // 7. REMOVE
        // =========================================================

        a.remove(2);

        System.out.println("After remove: " + a);


        // =========================================================
        // 8. ITERATING
        // =========================================================

        for (Integer value : treeSet) {
            System.out.println(value);
        }
    }
}


